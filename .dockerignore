# Build context for disposable installer and SSH acceptance fixtures.
# Keep the build context lean. Anything not strictly needed for `pnpm
# install` + `pnpm build` shouldn't be sent to the daemon — speeds up
# every COPY and avoids accidentally baking your local state into the
# image.

# Per-machine state
data
logs
*.log

# Build artifacts (we rebuild inside the image)
dist
**/dist
node_modules
**/node_modules
ui/.vite
electron/dist
# Test hosts omit Electron packaging but the UI imports these pure activity modules.
apps/desktop/**
!apps/desktop/src/
!apps/desktop/src/activity-journal-types.ts
!apps/desktop/src/activity-projection.ts
!apps/desktop/src/activity-policy.ts
!apps/desktop/src/activity-announcements.ts
!apps/desktop/src/activity-controller.ts
!apps/desktop/src/notification-queue.ts

# Editor / IDE
.vscode
.idea
.DS_Store

# VCS + CI
.git
.github

# Test scratch / browser fixtures
.playwright-mcp
coverage
.nyc_output
