{
  "name": "open-alice",
  "version": "0.95.0-beta",
  "description": "File-based trading agent engine",
  "type": "module",
  "imports": {
    "#openalice/pty-backend": {
      "bun": "./src/workspaces/pty-bun.ts",
      "default": "./src/workspaces/pty-node.ts"
    }
  },
  "main": "dist/electron/main.js",
  "scripts": {
    "cli": "node packages/cli/bin/openalice.ts",
    "dev": "tsx scripts/guardian/dev.ts",
    "dev:no-relay": "tsx scripts/guardian/dev.ts --no-relay",
    "dev:onboarding": "tsx scripts/onboarding-test-dev.ts",
    "remote": "node packages/cli/bin/openalice.ts --remote",
    "prebuild": "tsx scripts/build-migration-index.ts",
    "build": "turbo run build --filter=!@traderalice/landing && tsup src/main.ts --format esm --dts",
    "prebuild:server": "tsx scripts/build-migration-index.ts",
    "build:server": "turbo run build --filter=!@traderalice/landing --filter=!@traderalice/desktop --filter=!./packages/uta-broker-* && tsup src/main.ts --format esm --dts",
    "build:bun:release": "bun scripts/cli/build-bun-release.ts",
    "build:cli-package-channels": "node scripts/cli/build-cli-package-channels.mjs",
    "pack:cli-npm": "node scripts/cli/pack-cli-npm-packages.mjs",
    "build:migration-index": "tsx scripts/build-migration-index.ts",
    "broker-packs:build": "turbo run build --filter=./packages/uta-broker-* && tsx scripts/build-broker-packs.ts && pnpm broker-packs:verify",
    "broker-packs:upgrade-smoke": "tsx scripts/broker-pack-upgrade-smoke.ts",
    "broker-packs:verify": "tsx scripts/verify-broker-packs.ts",
    "start": "node dist/main.js",
    "electron:tsc": "pnpm -F @traderalice/desktop build && node scripts/desktop/build-desktop-relay.mjs",
    "electron:build": "pnpm build && pnpm electron:tsc",
    "electron:smoke:demo": "node scripts/electron-demo/run.mjs --smoke",
    "electron:demo": "node scripts/electron-demo/run.mjs",
    "electron:dev": "pnpm electron:build && pnpm -F @traderalice/desktop dev",
    "electron:pack": "pnpm electron:build && pnpm vendor:runtime && pnpm -F @traderalice/desktop run pack",
    "electron:assert-package": "node scripts/desktop/assert-desktop-package.mjs",
    "electron:verify-update-assets": "node scripts/desktop/verify-desktop-update-assets.mjs",
    "electron:smoke-toolchain": "node scripts/desktop/smoke-packaged-toolchain.mjs",
    "electron:smoke:packaged": "node scripts/desktop/desktop-packaged-smoke.mjs",
    "electron:smoke:startup": "node scripts/desktop/desktop-startup-smoke.mjs",
    "electron:smoke:credential-pi": "node scripts/desktop/desktop-packaged-smoke.mjs --credential-pi",
    "electron:smoke:onboarding": "node scripts/desktop/desktop-packaged-smoke.mjs --onboarding",
    "electron:smoke:trading-mode": "node scripts/desktop/desktop-packaged-smoke.mjs --trading-mode",
    "electron:smoke:workspace": "node scripts/desktop/desktop-packaged-smoke.mjs --workspace-acceptance",
    "electron:smoke:pty": "node scripts/desktop/desktop-pty-smoke.mjs",
    "electron:smoke:guardian-recovery": "node scripts/desktop/desktop-pty-smoke.mjs --guardian-recovery",
    "electron:smoke:existing-owner": "node scripts/desktop/desktop-existing-owner-smoke.mjs",
    "electron:smoke:upgrade": "node scripts/desktop/desktop-upgrade-smoke.mjs",
    "vendor:runtime": "node scripts/desktop/vendor-managed-runtime.mjs",
    "test": "vp test run --config vitest.config.ts",
    "test:changed": "vp test run --config vitest.config.ts --changed origin/dev --passWithNoTests",
    "test:watch": "vp test --config vitest.config.ts --watch",
    "test:integration": "vp test run --config vitest.integration.config.ts",
    "test:e2e": "vp test run --config vitest.integration.config.ts tests/e2e",
    "test:system:dev-stack": "tsx scripts/guardian/smoke.ts",
    "test:system:guardian": "tsx scripts/guardian/runtime-recovery-smoke.ts",
    "test:system:connector": "node scripts/connector-service-smoke.mjs",
    "test:system:installer": "node scripts/cli/install-docker-smoke.mjs",
    "test:system:installer:dev": "node scripts/cli/install-channel-smoke.mjs",
    "test:system:remote": "node scripts/cli/remote-ssh-smoke.mjs",
    "test:external:readonly": "vp test run --config vitest.external.config.ts",
    "test:live:uta-paper": "vp test run --config vitest.uta-live.config.ts tests/integration/broker-alpaca-paper tests/integration/broker-bybit-paper tests/integration/broker-hyperliquid-paper tests/integration/broker-ibkr-paper tests/integration/broker-okx-paper tests/integration/ibkr-wire-paper",
    "test:live:ibkr-paper": "vp test run --config vitest.uta-live.config.ts tests/integration/broker-ibkr-paper tests/integration/ibkr-wire-paper",
    "test:live:bybit-paper": "vp test run --config vitest.uta-live.config.ts tests/integration/broker-bybit-paper",
    "test:live:okx-paper": "vp test run --config vitest.uta-live.config.ts tests/integration/broker-okx-paper",
    "test:live:alpaca-paper": "vp test run --config vitest.uta-live.config.ts tests/integration/broker-alpaca-paper",
    "test:live:hyperliquid-paper": "vp test run --config vitest.uta-live.config.ts tests/integration/broker-hyperliquid-paper",
    "test:live:bybit-diagnostic": "vp test run --config vitest.uta-live.config.ts tests/integration/bybit-diagnostic",
    "landing:dev": "pnpm --filter @traderalice/landing dev",
    "landing:build": "pnpm --filter @traderalice/landing build"
  },
  "keywords": [
    "trading",
    "ai-agent",
    "crypto",
    "securities",
    "file-driven"
  ],
  "author": "OpenAlice Contributors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraderAlice/OpenAlice.git"
  },
  "homepage": "https://traderalice.com",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@traderalice/connector-protocol": "workspace:*",
    "@traderalice/guardian-runtime": "workspace:*",
    "@traderalice/ibkr": "workspace:*",
    "@traderalice/opentypebb": "workspace:*",
    "@traderalice/update-lifecycle": "workspace:*",
    "@traderalice/uta-protocol": "workspace:*",
    "@xterm/addon-serialize": "0.15.0-beta.287",
    "@xterm/headless": "6.1.0-beta.287",
    "ai": "^6.0.86",
    "chardet": "2.2.0",
    "cron-parser": "^5.6.1",
    "decimal.js": "^10.6.0",
    "dugite": "3.2.2",
    "electron-updater": "^6.8.9",
    "hono": "^4.12.32",
    "iconv-lite": "0.7.2",
    "node-pty": "^1.1.0",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "tar": "^7.5.22",
    "viem": "^2.48.7",
    "ws": "^8.19.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "build": {
    "appId": "com.traderalice.openalice",
    "productName": "OpenAlice",
    "directories": {
      "output": "dist/electron-app"
    },
    "electronVersion": "39.8.10",
    "asar": true,
    "files": [
      "dist/*.js",
      "dist/electron/**",
      "services/uta/dist/**",
      "services/uta/package.json",
      "services/connector/dist/**",
      "services/connector/package.json",
      "package.json",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.ts.map",
      "!node_modules/**/*.map",
      "!node_modules/**/_types/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "apps/desktop/build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "apps/desktop/build/icon.ico",
      "files": [
        {
          "from": ".",
          "filter": [
            "package.json",
            "!node_modules/dugite/git/**"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "apps/desktop/build/installer.nsh",
      "artifactName": "OpenAlice.Setup.${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://download.openalice.ai/"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/dugite/git/**"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "runtime",
        "filter": [
          "ui/dist/**",
          "default/**",
          "src/workspaces/cli/**",
          "src/workspaces/templates/**",
          "vendor/**",
          "!**/node_modules/**/*.d.ts",
          "!**/node_modules/**/*.d.ts.map",
          "!**/node_modules/**/*.map",
          "!**/node_modules/**/_types/**",
          "!vendor/pi/package-lock.json"
        ]
      }
    ],
    "afterPack": "../../scripts/desktop/desktop-after-pack.mjs"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@electron/asar": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "^29.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "react-i18next": "^17.0.8",
    "msw": "^2.14.6",
    "ccxt": "^4.5.78",
    "yahoo-finance2": "^3.13.1"
  }
}
