{
  "name": "@traderalice/ibkr",
  "version": "0.1.0",
  "description": "TypeScript port of IBKR TWS API v10.44.01",
  "type": "module",
  "exports": {
    ".": {
      "openalice-source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraderAlice/OpenAlice.git",
    "directory": "packages/ibkr"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "vp test run --config ../../vitest.config.ts packages/ibkr",
    "test:external:readonly": "vp test run --config ../../vitest.external.config.ts tests/integration/ibkr-wire-readonly",
    "test:live-paper": "vp test run --config ../../vitest.uta-live.config.ts tests/integration/ibkr-wire-paper tests/integration/broker-ibkr-paper",
    "typecheck": "tsc --noEmit",
    "generate:proto": "bash generate-proto.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "decimal.js": "^10.6.0",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "ts-proto": "^2.11.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "AGPL-3.0"
}
