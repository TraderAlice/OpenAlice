# Required for non-dev use. Leave empty only on trusted loopback.
GATEWAY_TOKEN=change-me

# Bind address (default: all interfaces inside the container / host).
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787

# SQLite path (created automatically).
GATEWAY_DB_PATH=./data/gateway.db

# Yahoo RSS source (override only if Yahoo moves the feed).
YAHOO_NEWS_RSS_URL=https://finance.yahoo.com/news/rssindex

# Poll interval for news collectors (seconds).
NEWS_POLL_SECONDS=600

# Quote cache TTL (seconds).
QUOTE_CACHE_SECONDS=60

# Optional browser-like UA — some vendors fingerprint bare clients.
HTTP_USER_AGENT=OpenAlice-MarketDataGateway/0.1
