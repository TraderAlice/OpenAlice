<?xml version="1.0" encoding="utf-8"?>
<!-- Upload this artifact configuration to the OpenAlice project in SignPath.
     GitHub's upload-artifact wraps the installer in a ZIP before submission. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="OpenAlice.Setup.*.exe" product-name="OpenAlice" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
