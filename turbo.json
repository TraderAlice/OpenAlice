{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "50%",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "open-alice-ui#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "open-alice-ui#build:demo": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@traderalice/openalice-cli#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@traderalice/landing#build": {
      "dependsOn": [],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": false,
      "env": ["NEXT_PUBLIC_MEDIA_BASE_URL"]
    }
  }
}
